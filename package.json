{
  "name": "cayeas-game-clubhouse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node --use-env-proxy --import tsx server/index.ts",
    "build": "vite build && tsc --noEmit",
    "typecheck": "tsr generate && tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "build:worker": "node scripts/build-worker.mjs",
    "smoke:worker": "node scripts/worker-smoke.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.0.0",
    "@tanstack/react-router": "^1.0.0",
    "drizzle-orm": "^0.45.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-cli": "^1.0.0",
    "@tanstack/router-plugin": "^1.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
