# Public browser configuration only. Never use a service-role key here.
VITE_SUPABASE_URL=https://spjxaghfxomgafgbrnkr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only secret for legacy Supabase sync (lounge name mirroring and
# pre-authorized cash allowances). Match rewards settle in D1 without it.
# Never prefix this name with VITE_ or commit a real key to this file.
# CLUBHOUSE_REWARD_KEY=
# Use a Supabase server secret/service-role key for the same project above.
# SUPABASE_SERVICE_ROLE_KEY and SUPABASE_SECRET_KEY are also supported.

# Optional game-service settings. Defaults work for local development.
# RUMMY_API_PORT=8787
# RUMMY_DATA_FILE=.data/rummy.sqlite
# Production: set RUMMY_HOST=0.0.0.0, RUMMY_COOKIE_SECURE=true, and
# RUMMY_ORIGIN to your actual HTTPS app origin.
